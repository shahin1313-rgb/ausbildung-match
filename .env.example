APP_NAME="Ausbildung Match"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

LEGAL_TERMS_VERSION=2026-09-18
LEGAL_PRIVACY_VERSION=2026-09-18
LEGAL_RESUME_RETENTION_DAYS=180
LEGAL_PROVIDER_NAME=
LEGAL_PROVIDER_LEGAL_FORM=
LEGAL_PROVIDER_REPRESENTATIVE=
LEGAL_PROVIDER_STREET_ADDRESS=
LEGAL_PROVIDER_POSTAL_CODE=
LEGAL_PROVIDER_CITY=
LEGAL_PROVIDER_COUNTRY=Deutschland
LEGAL_PROVIDER_EMAIL=
LEGAL_PROVIDER_PHONE=
LEGAL_PROVIDER_REGISTER_NAME=
LEGAL_PROVIDER_REGISTER_NUMBER=
LEGAL_PROVIDER_VAT_ID=
LEGAL_PROVIDER_SUPERVISORY_AUTHORITY=
LEGAL_PROVIDER_RESPONSIBLE_CONTENT=
LEGAL_DATA_PROTECTION_EMAIL=

# ClamAV is mandatory by default in production and failures are handled closed.
# RESUME_MALWARE_SCAN=true
RESUME_SCANNER_BINARY=clamdscan
RESUME_SCANNER_TIMEOUT=30

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ausbildung_match
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=localhost:8000,127.0.0.1:8000,localhost:5173,127.0.0.1:5173

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=sample-smtp-user
MAIL_PASSWORD=replace-with-smtp-secret
MAIL_ENCRYPTION=tls
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="Ausbildung Match"

FRONTEND_DEV_SERVER_URL=
FRONTEND_URL=http://localhost:8000

# Browser security headers. HSTS is emitted only for HTTPS requests.
SECURITY_HEADERS_ENABLED=true
CSP_REPORT_ONLY=false
HSTS_ENABLED=true
HSTS_VALUE="max-age=31536000; includeSubDomains"

SEED_DEMO_DATA=true
SEED_ADMIN_USER=false
ADMIN_NAME="Site Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=
WEEKLY_DIGEST_EMAIL=admin@example.com
