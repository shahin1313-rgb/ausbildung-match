--- /dev/null
+++ b/resources/js/components/LegalPages.tsx
@@ -0,0 +1,89 @@
+import type { ReactNode } from "react";
+import type { LegalConfig, LegalProvider } from "../types";
+
+export type LegalPageKey = "privacy" | "terms" | "impressum" | "resume-retention";
+
+type Props = { page: LegalPageKey; legal: LegalConfig };
+
+const missing = "در تنظیمات محیطی تکمیل شود";
+const value = (input: string | null) => input?.trim() || missing;
+
+function Contact({ provider, privacy = false }: { provider: LegalProvider; privacy?: boolean }) {
+  return (
+    <address className="legal-address">
+      <strong>{value(provider.name)}</strong>
+      <span>{[provider.street_address, provider.postal_code, provider.city, provider.country].filter(Boolean).join("، ") || missing}</span>
+      <span>ایمیل: {value(privacy ? provider.data_protection_email || provider.email : provider.email)}</span>
+      {provider.phone && <span>تلفن: {provider.phone}</span>}
+    </address>
+  );
+}
+
+export default function LegalPages({ page, legal }: Props) {
+  const p = legal.provider;
+  const incomplete = !p.name || !p.street_address || !p.city || !p.email;
+
+  if (page === "privacy") return (
+    <LegalShell title="سیاست حریم خصوصی" subtitle={`نسخه ${legal.privacy_version}`}>
+      <h2>۱. مسئول پردازش اطلاعات</h2><Contact provider={p} privacy />
+      <h2>۲. چه اطلاعاتی پردازش می‌شود؟</h2>
+      <p>اطلاعات حساب و تماس، وضعیت تأیید ایمیل، پروفایل تحصیلی و شغلی، رزومه و داده‌های استخراج‌شده از آن، علاقه‌مندی‌ها، درخواست‌های شغلی، پیام متقاضی و داده‌های فنی و امنیتی ضروری مانند نشانی IP و گزارش خطا پردازش می‌شوند.</p>
+      <h2>۳. هدف و مبنای پردازش</h2>
+      <ul><li>ساخت و ایمن‌سازی حساب و ارائه قابلیت‌های قراردادی سرویس؛</li><li>تطبیق فرصت‌ها و ساخت مدارک بنا بر درخواست کاربر؛</li><li>نگهداری رزومه با رضایت صریح کاربر؛</li><li>ارسال اطلاعات به کارفرمای مشخص فقط پس از تأیید جداگانه کاربر؛</li><li>پیشگیری از سوءاستفاده و رعایت تکالیف قانونی و منافع مشروع امنیتی.</li></ul>
+      <h2>۴. دریافت‌کنندگان و انتقال داده</h2>
+      <p>اطلاعات فقط به ارائه‌دهندگان فنی ضروری (مانند میزبانی و ایمیل) و، هنگام درخواست مستقیم، به شرکت آگهی‌دهنده منتقل می‌شود. اطلاعات فروخته نمی‌شود. هر انتقال برون‌مرزی باید با سازوکار معتبر حفاظت از داده و قرارداد مناسب انجام شود.</p>
+      <h2>۵. مدت نگهداری</h2>
+      <p>رزومه حداکثر {legal.resume_retention_days} روز پس از بارگذاری نگهداری و سپس به‌طور خودکار حذف می‌شود، مگر الزام قانونی معتبر یا درخواست زودتر کاربر وجود داشته باشد. داده‌های حساب تا حذف حساب یا پایان نیاز قراردادی و داده‌های امنیتی فقط به مدت ضروری نگهداری می‌شوند.</p>
+      <h2>۶. تطبیق خودکار</h2>
+      <p>امتیاز تطبیق، پیشنهاد توضیح‌پذیر بر پایه فیلدهای پروفایل و آگهی است و تصمیم استخدامی یا تصمیم حقوقی خودکار محسوب نمی‌شود. تصمیم نهایی با کاربر و کارفرماست.</p>
+      <h2>۷. کوکی‌ها و امنیت</h2><p>کوکی‌های Session و CSRF برای ورود امن و جلوگیری از جعل درخواست استفاده می‌شوند. این کوکی‌های ضروری برای عملکرد حساب لازم‌اند. دسترسی به فایل رزومه عمومی نیست و کنترل دسترسی سمت سرور اعمال می‌شود.</p>
+      <h2>۸. حقوق شما</h2>
+      <p>در چارچوب GDPR می‌توانید دسترسی، اصلاح، حذف، محدودسازی، قابلیت انتقال داده و اعتراض را درخواست کنید. رضایت را می‌توان برای آینده پس گرفت. همچنین حق شکایت نزد مرجع ناظر حفاظت از داده محل اقامت یا محل فعالیت مسئول پردازش محفوظ است.</p>
+      <h2>۹. تماس و تغییرات</h2><p>درخواست‌های حریم خصوصی را به نشانی زیر بفرستید. تغییرات اساسی همراه با نسخه و تاریخ جدید اعلام می‌شوند.</p><Contact provider={p} privacy />
+    </LegalShell>
+  );
+
+  if (page === "terms") return (
+    <LegalShell title="شرایط استفاده" subtitle={`نسخه ${legal.terms_version}`}>
+      <h2>۱. موضوع سرویس</h2><p>Ausbildung Match ابزار جست‌وجو، تطبیق اولیه، آماده‌سازی مدارک و مدیریت درخواست‌هاست. سرویس، مؤسسه کاریابی رسمی یا مشاور حقوقی/مهاجرتی نیست و پذیرش، ویزا یا استخدام را تضمین نمی‌کند.</p>
+      <h2>۲. حساب کاربری</h2><p>کاربر باید اطلاعات درست و به‌روز ارائه کند، از دسترسی حساب محافظت کند و سوءاستفاده را فوراً گزارش دهد. استفاده غیرقانونی، جعل هویت، جمع‌آوری خودکار مخرب، دورزدن کنترل‌های امنیتی و انتشار محتوای ناقض حقوق دیگران ممنوع است.</p>
+      <h2>۳. محتوای کاربر و درخواست‌ها</h2><p>مالکیت رزومه و محتوای کاربر برای او باقی می‌ماند. کاربر فقط مجوز محدود لازم برای ذخیره، پردازش و ارسال انتخاب‌شده را به سرویس می‌دهد. مسئولیت صحت و مجازبودن اطلاعات ارسالی با کاربر است.</p>
+      <h2>۴. کارفرمایان و آگهی‌ها</h2><p>کارفرما باید هویت، شرکت و آگهی‌های خود را درست معرفی کند. انتشار آگهی منوط به تأیید شرکت است. امکان حذف آگهی گمراه‌کننده، تعلیق حساب و بررسی گزارش تخلف وجود دارد.</p>
+      <h2>۵. منابع و پیوندهای بیرونی</h2><p>آگهی‌ها ممکن است از منابع ثالث باشند. جزئیات، مهلت و شرایط را پیش از اقدام در منبع رسمی کنترل کنید؛ مسئولیت محتوای وب‌سایت‌های ثالث با همان ارائه‌دهنده است.</p>
+      <h2>۶. دسترس‌پذیری و مسئولیت</h2><p>برای پایداری و صحت سرویس تلاش می‌شود، اما دسترسی بدون وقفه یا نتیجه مشخص تضمین نمی‌شود. محدودیت مسئولیت، موارد عمد، تقصیر سنگین، آسیب جسمی و حقوقی را که قانوناً قابل محدودکردن نیستند شامل نمی‌شود.</p>
+      <h2>۷. پایان استفاده و تغییر شرایط</h2><p>کاربر می‌تواند استفاده را متوقف و حذف داده را درخواست کند. در صورت نقض شرایط یا خطر امنیتی، دسترسی ممکن است محدود شود. تغییرات مهم با نسخه جدید و، هرجا لازم باشد، اخذ پذیرش تازه اعمال می‌شوند.</p>
+      <h2>۸. قانون و تماس</h2><p>قانون آلمان با حفظ حمایت‌های اجباری مصرف‌کننده در کشور محل اقامت اعمال می‌شود. برای پرسش‌های قراردادی با ارائه‌دهنده تماس بگیرید.</p><Contact provider={p} />
+    </LegalShell>
+  );
+
+  if (page === "resume-retention") return (
+    <LegalShell title="سیاست نگهداری رزومه" subtitle={`دوره استاندارد: ${legal.resume_retention_days} روز`}>
+      <h2>دامنه و رضایت</h2><p>بارگذاری رزومه اختیاری است و فقط پس از علامت‌زدن رضایت جداگانه انجام می‌شود. زمان رضایت و تاریخ انقضای هر فایل ثبت می‌گردد.</p>
+      <h2>نگهداری و حذف</h2><p>فایل در فضای خصوصی ذخیره و حداکثر {legal.resume_retention_days} روز پس از بارگذاری به‌صورت خودکار حذف می‌شود. کاربر می‌تواند هر زمان زودتر آن را از پروفایل حذف کند. نسخه‌های پشتیبان محدود ممکن است تا چرخه حذف فنی باقی بمانند و در این مدت برای استفاده عادی بازیابی نمی‌شوند.</p>
+      <h2>اشتراک‌گذاری با کارفرما</h2><p>آپلود رزومه به‌تنهایی به معنی ارسال آن نیست. در درخواست مستقیم، نام، ایمیل، اطلاعات مرتبط پروفایل، پیام و رزومه اصلی فقط پس از رضایت صریح جداگانه در اختیار شرکت همان آگهی قرار می‌گیرد. پس از دریافت، نگهداری نسخه کارفرما تابع سیاست و تکالیف قانونی همان شرکت است.</p>
+      <h2>پس‌گرفتن رضایت</h2><p>رضایت را می‌توان برای آینده پس گرفت و فایل را حذف کرد؛ این کار قانونی‌بودن پردازش پیش از پس‌گرفتن را تغییر نمی‌دهد. برای درخواست تکمیلی با مسئول حفاظت از داده تماس بگیرید.</p><Contact provider={p} privacy />
+    </LegalShell>
+  );
+
+  return (
+    <LegalShell title="Impressum" subtitle="Angaben gemäß § 5 DDG">
+      {incomplete && <div className="legal-warning" role="alert">اطلاعات الزامی ارائه‌دهنده هنوز کامل نیست. پیش از انتشار عمومی، متغیرهای LEGAL_PROVIDER_* در محیط production تکمیل و متن توسط مشاور حقوقی بررسی شود.</div>}
+      <h2>Anbieter / Diensteanbieter</h2><Contact provider={p} />
+      <dl className="legal-details">
+        <div><dt>Rechtsform</dt><dd>{value(p.legal_form)}</dd></div>
+        <div><dt>Vertretungsberechtigte Person</dt><dd>{value(p.representative)}</dd></div>
+        <div><dt>Register</dt><dd>{value(p.register_name)}</dd></div>
+        <div><dt>Registernummer</dt><dd>{value(p.register_number)}</dd></div>
+        <div><dt>USt-IdNr.</dt><dd>{value(p.vat_id)}</dd></div>
+        <div><dt>Zuständige Aufsichtsbehörde (falls erforderlich)</dt><dd>{value(p.supervisory_authority)}</dd></div>
+        <div><dt>Inhaltlich verantwortlich</dt><dd>{value(p.responsible_content)}</dd></div>
+      </dl>
+      <h2>Kontakt</h2><p>E-Mail: {value(p.email)}{p.phone ? ` · Telefon: ${p.phone}` : ""}</p>
+      <h2>Hinweis</h2><p>اطلاعات این صفحه باید با شکل حقوقی، مجوزها، ثبت تجاری و وضعیت مالیاتی واقعی ارائه‌دهنده تطبیق داده شود. فیلدهای نامرتبط را می‌توان پس از بررسی حقوقی حذف کرد.</p>
+    </LegalShell>
+  );
+}
+
+function LegalShell({ title, subtitle, children }: { title: string; subtitle: string; children: ReactNode }) {
+  return <section className="legal-page container"><header><span>{subtitle}</span><h1>{title}</h1><p>آخرین به‌روزرسانی: ۲۷ شهریور ۱۴۰۵ / ۱۸ سپتامبر ۲۰۲۶</p></header><article>{children}</article></section>;
+}
